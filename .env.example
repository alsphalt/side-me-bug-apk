# Copy this file to .env and fill in your own ACRCloud credentials.
# .env is never committed and is never read from source code.
#
# Rotate any key that has been pasted into a chat, an issue tracker, a screenshot
# or a public repository. ACRCloud keys can be reset in the ACRCloud console.
ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_access_key_here
ACRCLOUD_ACCESS_SECRET=your_access_secret_here

# --- DARKNOTE AI ---------------------------------------------------------
# Provider key. Never hardcode this in source; it is read here or from
# config.json -> ai.apikey, and the environment always wins.
MZAZI_API_KEY=your_mzazi_api_key_here

# Optional overrides. Anything not set here falls back to config.json -> "ai".
# AI_CHATBOT_ENABLED=false
# AI_DM_ENABLED=true
# AI_GROUP_ENABLED=true
# AI_TYPING_ENABLED=true
# AI_MEMORY_ENABLED=true
# AI_RESPONSE_TIMING_ENABLED=true
# AI_REACTIONS_ENABLED=false
# AI_DM_DELAY=15
# AI_SHORT_DELAY=4
# AI_LONG_DELAY_MIN=13
# AI_LONG_DELAY_MAX=20
# AI_GROUP_DELAY_MIN=15
# AI_GROUP_DELAY_MAX=17
# AI_RATE_USER_PER_MIN=6
# AI_RATE_GROUP_PER_MIN=12
# AI_TIMEOUT_MS=60000
# AI_RETRIES=2
